# Annie Environment Configuration (Zero-Key Judge Default)
# Copy to .env: cp .env.example .env

PORT=3000
NODE_ENV=development

# Database (local SQLite default; zero external keys needed)
DATABASE_URL=./data/annie.db

# Encryption key for OAuth Token Vault (32-byte hex; auto-generated ephemeral key in sandbox dev if unset)
ENCRYPTION_KEY=

# LLM Provider: "mock" (zero-key deterministic), "ollama" (local), "groq", "gemini", or "workers-ai"
LLM_PROVIDER=mock
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen3:4b

# Optional Free Cloud LLM Accelerators (never required for judge setup)
GROQ_API_KEY=
GEMINI_API_KEY=

# Safety & Budget Caps (hard-enforced in src/core/policy.ts)
ALLOW_PAYMENTS=false
MAX_ESTIMATED_COST_USD=0.01

# Optional Proactive Push (ntfy.sh — keyless public or self-hosted topic)
NTFY_TOPIC=

# Optional Messaging Channels (Web PWA + Mock CLI require zero keys)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
BLUEBUBBLES_SERVER_URL=
BLUEBUBBLES_PASSWORD=
BLUEBUBBLES_WEBHOOK_SECRET=

# Optional Pro & Voice Accelerators (free tiers / partner credits)
TREG_TOKEN=
OPENROUTESERVICE_API_KEY=
TELNYX_API_KEY=
TELNYX_FROM_NUMBER=
